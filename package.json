{
  "name": "@loomhelix/deptrail",
  "version": "0.1.0",
  "description": "Explore the dependency trees of every JavaScript root in a repository: issues, dependents and fixes in a local web viewer",
  "keywords": [
    "dependencies",
    "dependency-tree",
    "monorepo",
    "pnpm",
    "npm",
    "lockfile",
    "vulnerabilities",
    "osv",
    "audit",
    "cli"
  ],
  "license": "MIT",
  "author": "loomhelix",
  "homepage": "https://github.com/loomhelix/deptrail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loomhelix/deptrail.git"
  },
  "bugs": {
    "url": "https://github.com/loomhelix/deptrail/issues"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "deptrail": "dist/cli/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "test:perf": "node --import tsx --test test/perf/perf.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:ui": "vite build ui --outDir ../dist/ui",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && pnpm build:cli && pnpm build:ui",
    "prepack": "pnpm build",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "playground": "pnpm build && node --import tsx scripts/playground.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "vue-tsc -p ui/tsconfig.json --noEmit"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  }
}
